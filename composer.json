    "type": "flarum-extension",
    "keywords": [
        "flarum",
        "discussions",
        "navigation",
        "heat"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ErnestDefoe\\Ridge\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Ridge",
            "category": "feature"
        }
    }
}
